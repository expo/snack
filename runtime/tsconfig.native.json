{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": false
  },
  "include": [
    "src/worker/*.js",
    "src/worker/*.d.ts",
    "index.js"
  ],
  "exclude": [
    "src/worker/flight-client.js"
  ]
}
