-export default requireNativeComponent;
+/**
+ * Cache components to prevent duplicate ViewManager registration when Snack
+ * evaluates another version of a package.
+ */
+const cache: {[string]: HostComponent<any>} = {};
+const requireNativeComponentCached = <T extends {...}>(
+  uiViewClassName: string,
+): HostComponent<T> => {
+  cache[uiViewClassName] = cache[uiViewClassName] || requireNativeComponent(uiViewClassName);
+  return cache[uiViewClassName];
+};
+
+export default requireNativeComponentCached;
