{
  "name": "snack",
  "version": "0.0.0",
  "description": "Playground for Expo!",
  "author": "exponent.team@gmail.com",
  "private": true,
  "main": "index.js",
  "owner": "exponent",
  "scripts": {
    "start": "EXPO_PUBLIC_SNACK_ENV=staging expo start",
    "web": "EXPO_PUBLIC_SNACK_ENV=staging expo start --web",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "typescript": "tsc",
    "test": "echo \"No tests\"",
    "deploy:staging": "EXPO_PUBLIC_SNACK_ENV=staging EXPO_STAGING=1 eas update --auto --branch production --environment production",
    "deploy:prod": "EXPO_PUBLIC_SNACK_ENV=production eas update --auto --branch production --environment production",
    "deploy:web:staging": "EXPO_PUBLIC_SNACK_ENV=staging node ./web/deploy-script.js",
    "deploy:web:prod": "EXPO_PUBLIC_SNACK_ENV=production node ./web/deploy-script.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "assert": "^2.1.0",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "path": "^0.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "snack-runtime": "file:../packages/snack-runtime"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/spawn-async": "^1.7.2",
    "@react-native/jest-preset": "0.88.1",
    "@types/diff": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^15.0.3",
    "expo-atlas": "^0.4.0",
    "getenv": "^1.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "^6.4.7",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.2.4",
    "s3-deploy": "^1.4.0",
    "semver": "^7.5.1",
    "typescript": "~6.0.3"
  },
  "eslintConfig": {
    "extends": "universe/native"
