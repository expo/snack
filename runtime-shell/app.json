{
  "expo": {
    "name": "Snack",
    "description": "Write code in Expo's online editor and instantly use it on your phone",
    "scheme": "snack",
    "owner": "exponent",
    "slug": "snack",
    "version": "1.0.0",
    "primaryColor": "#000000",
    "icon": "./assets/icon.png",
    "developmentClient": {
      "silentLaunch": true
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png"
        }
      ],
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
